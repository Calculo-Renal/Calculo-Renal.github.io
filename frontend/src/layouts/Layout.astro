---
import Header from "@/components/layout/Header.astro";
import Stack from "@/components/ui/Stack.astro";

import "@/styles/global.css";
import "katex/dist/katex.min.css";
import "@fontsource-variable/inter";
import "@fontsource-variable/funnel-display";
---

<html lang="pt-BR" class="scroll-smooth">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/png" href="/favicon.png" media="(prefers-color-scheme: light)" />
        <link rel="icon" type="image/png" href="/favicon-dark.png" media="(prefers-color-scheme: dark)" />
        <meta name="generator" content={Astro.generator} />
        <title>Cálculo Renal</title>
    </head>
    <body class="flex min-h-full flex-col m-0 bg-background text-info transition-colors duration-200">
        <Header />
        <main class="flex flex-1 flex-col px-4 py-6 sm:px-8 sm:py-8 lg:px-[20%]">
            <Stack>
                <slot />
            </Stack>
        </main>
    </body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
    }
</style>