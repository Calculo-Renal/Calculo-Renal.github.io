---
import Header from "@/components/layout/Header.astro";
import Stack from "@/components/ui/Stack.astro";

import "@/styles/global.css";
import "katex/dist/katex.min.css";
import "@fontsource-variable/inter";
import "@fontsource-variable/funnel-display";
---

<html lang="pt-BR" class="h-full scroll-smooth">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/png" href="/favicon.png" media="(prefers-color-scheme: light)" />
        <link rel="icon" type="image/png" href="/favicon-dark.png" media="(prefers-color-scheme: dark)" />
        <meta name="generator" content={Astro.generator} />
        <title>Cálculo Renal</title>
    </head>
    <body class="flex min-h-dvh flex-col m-0 bg-background text-info transition-colors duration-200 md:h-dvh md:overflow-hidden">
        <Header />
        <main class="flex flex-1 flex-col px-8 py-6 md:min-h-0 md:overflow-hidden lg:px-[20%]">
            <Stack fill>
                <slot />
            </Stack>
        </main>
    </body>
</html>

<script>
    const reader = document.querySelector<HTMLElement>('[data-book-reader]');
    const navigation = document.querySelector<HTMLElement>('[data-book-navigation]');
    const desktopMedia = window.matchMedia('(min-width: 768px)');

    const forwardWheelToBook = (event: WheelEvent) => {
        if (!reader || !desktopMedia.matches) return;

        const navigationRight = navigation?.getBoundingClientRect().right ?? window.innerWidth / 2;
        const readerLeft = reader.getBoundingClientRect().left;
        const splitPoint = (navigationRight + readerLeft) / 2;
        const target = event.clientX < splitPoint ? navigation : reader;
        if (!target) return;

        event.preventDefault();
        target.scrollTop += event.deltaY;
    };

    window.addEventListener('wheel', forwardWheelToBook, { passive: false });
</script>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
    }
</style>
