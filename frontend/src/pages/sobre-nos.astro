---
import Heading from '@/components/ui/Heading.astro';
import ProfileCard from '@/components/ui/ProfileCard.astro';
import Stack from '@/components/ui/Stack.astro';
import Text from '@/components/ui/Text.astro';
import Layout from '@/layouts/Layout.astro';
import izabelaImage from '@/assets/images/sobre-nos/izabela-pfp.png';

interface Creator {
  name: string;
  image: string;
  href: string | null;
}

const creators: Creator[] = [
  { name: 'Izabela Marques', image: izabelaImage.src, href: null },
  { name: 'Frederico Loureiro', image: 'https://github.com/frxd-sloureiro.png', href: 'https://github.com/frxd-sloureiro' },
  { name: 'Jean Carlo', image: 'https://github.com/JeanC4rlo.png', href: 'https://github.com/JeanC4rlo' },
  { name: 'Guilherme Malard', image: 'https://github.com/GuilhermeMalard.png', href: 'https://github.com/GuilhermeMalard' },
  { name: 'Pedro Soares', image: 'https://github.com/pedrosoares01.png', href: 'https://github.com/pedrosoares01' },
  { name: 'Pedro Peixoto', image: 'https://github.com/pedropsaraiva.png', href: 'https://github.com/pedropsaraiva' },
];
---

<Layout>
  <Stack gap="lg">
    <section>
      <Stack gap="sm">
      <Heading level={0}>Sobre nós</Heading>
      <Text>
        A motivação para criação deste site foi um projeto de extensão proposto por nossa orientadora,
        Izabela, que visava ajudar alunos do ensino técnico e da graduação na aprendizagem da disciplina
        de Cálculo. O projeto reúne um livro digital gratuito e uma série de conquistas para tornar o
        aprendizado mais acessível, interativo e motivador.
      </Text>
      </Stack>
    </section>

    <section>
      <Heading level={2}>Criadores</Heading>
      <div class="flex flex-wrap items-start gap-4">
        {creators.map((creator) => (
          <ProfileCard
            name={creator.name}
            image={creator.image}
            href={creator.href}
          />
        ))}
      </div>
    </section>
  </Stack>
</Layout>
