---
import Link from '@/components/ui/Link.astro';

interface Props {
  name: string;
  image: string;
  href: string | null;
}

const { name, image, href } = Astro.props;
---

<div class="flex w-40 max-w-full flex-col items-center">
  {href ? (
    <Link
      href={href}
      target="_blank"
      rel="noreferrer"
      aria-label={`Abrir perfil de ${name} no GitHub`}
      variant="profile"
    >
      <span class="profile-avatar">
        <img src={image} alt={`Foto de ${name}`} loading="lazy" />
      </span>
      <span class="text-center font-sans text-sm text-info transition-colors group-hover:text-primary">{name}</span>
    </Link>
  ) : (
    <div class="flex w-full flex-col items-center gap-3 rounded-md p-3">
      <span class="profile-avatar">
        <img src={image} alt={`Foto de ${name}`} />
      </span>
      <span class="text-center font-sans text-sm text-info">{name}</span>
    </div>
  )}
</div>

<style>
  .profile-avatar {
    width: 9rem;
    height: 9rem;
    aspect-ratio: 1;
    flex: 0 0 9rem;
    overflow: hidden;
    border-radius: 50%;
  }

  .profile-avatar img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
