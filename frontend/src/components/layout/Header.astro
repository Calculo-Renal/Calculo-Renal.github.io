---
import Logo from '@/components/ui/Logo.astro';
import Link from '@/components/ui/Link.astro';
import Navigation from '@/components/layout/Navigation.astro';
---

<header class="sticky top-0 z-30 w-full bg-surface border-b border-border transition-colors duration-200">
  <div class="flex w-full items-center justify-between py-3 px-4 md:px-[20%]">
    <Link href="/">
      <Logo />
    </Link>

    <div class="hidden md:flex items-center gap-1">
      <Navigation />
    </div>
  </div>
</header>