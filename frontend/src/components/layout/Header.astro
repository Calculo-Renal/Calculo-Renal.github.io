---
import Logo from '@/components/ui/Logo.astro';
import Link from '@/components/ui/Link.astro';
import Navigation from '@/components/layout/Navigation.astro';
import { Menu, X } from '@lucide/astro';
---

<header class="sticky top-0 z-30 w-full bg-surface border-b border-border transition-colors duration-200">
  <div class="relative flex w-full items-center justify-between gap-4 py-3 px-4 sm:px-8 lg:px-[20%]">
    <Link href="/" class="absolute left-1/2 shrink-0 -translate-x-1/2 md:static md:translate-x-0">
      <Logo />
    </Link>

    <div class="hidden ml-auto items-center gap-1 md:flex">
      <Navigation />
    </div>

    <button
      type="button"
      class="ml-auto inline-flex size-10 cursor-pointer items-center justify-center rounded-md border border-border text-info transition-colors hover:bg-surface-active md:hidden"
      aria-label="Abrir menu"
      aria-controls="mobile-navigation"
      aria-expanded="false"
      data-menu-toggle
    >
      <span class="sr-only">Abrir menu</span>
      <Menu size={20} aria-hidden="true" />
    </button>
  </div>

  <div class="fixed inset-0 z-40 hidden bg-black/30 md:hidden" data-menu-backdrop></div>
  <aside
    id="mobile-navigation"
    class="fixed right-0 top-0 z-50 flex h-dvh w-[min(18rem,85vw)] translate-x-full flex-col gap-8 bg-surface p-6 shadow-xl transition-transform duration-200 md:hidden"
    aria-label="Menu principal"
    aria-hidden="true"
    data-mobile-menu
  >
    <div class="flex items-center justify-between">
      <span class="font-heading text-lg font-semibold text-info">Menu</span>
      <button
        type="button"
        class="inline-flex size-10 cursor-pointer items-center justify-center rounded-md border border-border text-info transition-colors hover:bg-surface-active"
        aria-label="Fechar menu"
        data-menu-close
      >
        <X size={20} aria-hidden="true" />
      </button>
    </div>
    <Navigation />
  </aside>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const close = document.querySelector<HTMLButtonElement>('[data-menu-close]');
  const backdrop = document.querySelector<HTMLElement>('[data-menu-backdrop]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');

  const setMenuState = (isOpen: boolean) => {
    if (!toggle || !menu || !backdrop) return;

    toggle.setAttribute('aria-expanded', String(isOpen));
    menu.setAttribute('aria-hidden', String(!isOpen));
    menu.classList.toggle('hidden', !isOpen);
    menu.classList.toggle('translate-x-full', !isOpen);
    menu.classList.toggle('translate-x-0', isOpen);
    backdrop.classList.toggle('hidden', !isOpen);
  };

  toggle?.addEventListener('click', () => setMenuState(true));
  close?.addEventListener('click', () => setMenuState(false));
  backdrop?.addEventListener('click', () => setMenuState(false));
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenuState(false)));
</script>