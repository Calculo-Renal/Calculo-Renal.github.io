---
import BookChapterLink from '@/components/layout/BookChapterLink.astro';
import BookTocLink from '@/components/layout/BookTocLink.astro';
import Heading from '@/components/ui/Heading.astro';
import type { Chapter } from '@/types/Chapter';
import { ChevronDown, ChevronUp } from '@lucide/astro';

interface Props {
  chapters: Chapter[];
  currentId: string;
  headings: {
    depth: number;
    slug: string;
    text: string;
  }[];
}

const { chapters, currentId, headings } = Astro.props;
---

<aside data-book-navigation class="book-navigation flex min-h-0 flex-col gap-4 self-start overflow-y-auto border-b border-border pb-4 md:h-full md:border-b-0 md:border-r md:pb-0 md:pr-6">
  <button
    type="button"
    class="flex cursor-pointer items-center justify-between text-left md:pointer-events-none"
    aria-expanded="false"
    aria-controls="book-navigation-content"
    data-book-navigation-toggle
  >
    <Heading level={2}>Capítulos</Heading>
    <span class="md:hidden" aria-hidden="true">
      <ChevronDown size={20} data-chevron-down />
      <ChevronUp size={20} class="hidden" data-chevron-up />
    </span>
  </button>
  <div id="book-navigation-content" class="hidden md:block" data-book-navigation-content>
    <nav aria-label="Navegação do livro" class="flex flex-col gap-2">
      {chapters.map((chapter) => (
        <div class="flex flex-col gap-1">
          <BookChapterLink
            chapter={chapter}
            variant={chapter.id === currentId ? 'active' : 'default'}
          />

          {chapter.id === currentId && headings.length > 0 && (
            <nav aria-label="Títulos do capítulo" class="relative flex flex-col gap-1 pl-4 before:absolute before:bottom-0 before:left-0 before:top-0 before:w-px before:bg-border before:content-['']">
              {headings.map((heading) => (
                <BookTocLink heading={heading} />
              ))}
            </nav>
          )}
        </div>
      ))}
    </nav>
  </div>
</aside>

<script>
  const navigationToggle = document.querySelector<HTMLButtonElement>('[data-book-navigation-toggle]');
  const navigationContent = document.querySelector<HTMLElement>('[data-book-navigation-content]');

  navigationToggle?.addEventListener('click', () => {
    if (!navigationContent) return;

    const isOpen = navigationToggle.getAttribute('aria-expanded') === 'true';
    navigationToggle.setAttribute('aria-expanded', String(!isOpen));
    navigationContent.classList.toggle('hidden', isOpen);
    navigationToggle.querySelector('[data-chevron-down]')?.classList.toggle('hidden', !isOpen);
    navigationToggle.querySelector('[data-chevron-up]')?.classList.toggle('hidden', isOpen);
  });

  const reader = document.querySelector<HTMLElement>('[data-book-reader]');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
  const sections = links
    .map((link) => document.getElementById(link.dataset.tocLink ?? ''))
    .filter((section): section is HTMLElement => section instanceof HTMLElement);

  const setActiveLink = (sectionId: string) => {
    links.forEach((link) => link.removeAttribute('aria-current'));
    links.find((link) => link.dataset.tocLink === sectionId)?.setAttribute('aria-current', 'location');
  };

  const initializeToc = () => {
    if (!reader || !links.length || !sections.length) return;

    links.forEach((link) => {
      link.addEventListener('click', (event) => {
        const section = sections.find((item) => item.id === link.dataset.tocLink);
        if (!section) return;

        event.preventDefault();
        window.history.replaceState(null, '', `#${section.id}`);
        setActiveLink(section.id);
        section.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    const visibleSections = new Set<HTMLElement>();
    let activeUpdateTimer: ReturnType<typeof setTimeout> | undefined;
    const activationLine = () => reader.getBoundingClientRect().top + 24;
    const updateActiveLink = () => {
      const line = activationLine();
      const activeSection = [...visibleSections].sort((first, second) => {
        const firstTop = first.getBoundingClientRect().top;
        const secondTop = second.getBoundingClientRect().top;
        const firstPassedLine = firstTop <= line;
        const secondPassedLine = secondTop <= line;

        if (firstPassedLine !== secondPassedLine) return firstPassedLine ? -1 : 1;
        return firstPassedLine ? secondTop - firstTop : firstTop - secondTop;
      })[0];

      if (activeSection) setActiveLink(activeSection.id);
    };

    const scheduleActiveLinkUpdate = () => {
      clearTimeout(activeUpdateTimer);
      activeUpdateTimer = setTimeout(updateActiveLink, 120);
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const section = entry.target as HTMLElement;
          if (entry.isIntersecting) visibleSections.add(section);
          else visibleSections.delete(section);
        });

        scheduleActiveLinkUpdate();
      },
      { root: reader, rootMargin: '-24px 0px -70% 0px', threshold: 0 },
    );

    sections.forEach((section) => observer.observe(section));
  };

  initializeToc();
</script>
