---
import BookNavigation from '@/components/layout/BookNavigation.astro';
import Heading from '@/components/ui/Heading.astro';
import type { Chapter } from '@/types/Chapter';
import { render } from 'astro:content';

interface Props {
  chapter: Chapter;
  chapters: Chapter[];
  headings: {
    depth: number;
    slug: string;
    text: string;
  }[];
}

const { chapter, chapters, headings } = Astro.props as Props;
const { Content } = await render(chapter);
---

<div class="grid h-full min-h-0 min-w-0 flex-1 grid-cols-1 gap-8 md:grid-cols-[minmax(20rem,1.25fr)_minmax(0,3fr)]">
  <BookNavigation chapters={chapters} currentId={chapter.id} headings={headings} />
  <main data-book-reader class="min-h-0 overflow-y-auto">
    <div class="flex w-full flex-col gap-4 prose dark:prose-invert [&>*]:m-0 [&_h1]:font-heading [&_h1]:font-semibold [&_h1]:text-3xl [&_h2]:font-heading [&_h2]:font-semibold [&_h2]:text-2xl [&_h3]:font-heading [&_h3]:font-semibold [&_h3]:text-xl [&_h4]:font-heading [&_h4]:font-semibold [&_h4]:text-lg [&_h5]:font-heading [&_h5]:font-semibold [&_h5]:text-base [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:space-y-2 [&_ol]:list-decimal [&_ol]:pl-6 [&_ol]:space-y-2">
      <Heading level={0}>{chapter.data.title}</Heading>
      <Content />
    </div>
  </main>
</div>
